{
  "name": "boho",
  "version": "2.2.0",
  "description": "Secure Lightweight Encryption & Authentication Library for Node.js, Browsers and Arduino.",
  "type": "module",
  "exports": {
    "types": "./dist/boho.d.ts",
    "import": "./dist/boho.js",
    "require": null
  },
  "types": "dist/boho.d.ts",
  "browser": "./dist/boho.min.js",
  "jsdelivr": "./dist/boho.min.js",
  "unpkg": "./dist/boho.min.js",
  "keywords": [
    "SSL",
    "cipher",
    "crypto",
    "encryption",
    "보호",
    "암호"
  ],
  "homepage": "https://github.com/remocons/boho#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remocons/boho.git"
  },
  "author": {
    "name": "Taeo Lee",
    "email": "sixgen@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.62.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "meta-buffer-pack": "^2.1.4"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "node --test test/*.js && npm run test:types",
    "pretest": "npm run build",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:arduino": "npm run build && node --test test/arduino/interop.test.js",
    "test:iosignal": "npm run build && node --import ./test/iosignal/register.js --test test/iosignal/full-flow.test.js"
  }
